<?xml version="1.0" encoding="utf-8"?>
<WorkflowBuilder Version="2.9.0"
                 xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
                 xmlns:rx="clr-namespace:Bonsai.Reactive;assembly=Bonsai.Core"
                 xmlns:harp="clr-namespace:Bonsai.Harp;assembly=Bonsai.Harp"
                 xmlns:beh="clr-namespace:Harp.Behavior;assembly=Harp.Behavior"
                 xmlns:scr="clr-namespace:Bonsai.Scripting.Expressions;assembly=Bonsai.Scripting.Expressions"
                 xmlns:dsp="clr-namespace:Bonsai.Dsp;assembly=Bonsai.Dsp"
                 xmlns:sys="clr-namespace:System;assembly=mscorlib"
                 xmlns:cv="clr-namespace:Bonsai.Vision;assembly=Bonsai.Vision"
                 xmlns:io="clr-namespace:Bonsai.IO;assembly=Bonsai.System"
                 xmlns:ffm="clr-namespace:Bonsai.FFmpeg;assembly=Bonsai.FFmpeg"
                 xmlns:spk="clr-namespace:Bonsai.Spinnaker;assembly=Bonsai.Spinnaker"
                 xmlns:orc="clr-namespace:OpenRigs.Core;assembly=OpenRigs.Core"
                 xmlns:orv="clr-namespace:OpenRigs.Video;assembly=OpenRigs.Video"
                 xmlns:zmq="clr-namespace:Bonsai.ZeroMQ;assembly=Bonsai.ZeroMQ"
                 xmlns:netmq="clr-namespace:NetMQ;assembly=NetMQ"
                 xmlns:ext="clr-namespace:UclOpenCoenBehaviourBox;assembly=Extensions"
                 xmlns:clm="clr-namespace:CoenLab.SessionManifest;assembly=Extensions"
                 xmlns:orcl="clr-namespace:OpenRigs.Control;assembly=OpenRigs.Control"
                 xmlns="https://bonsai-rx.org/2018/workflow">
  <Workflow>
    <Nodes>
      <Expression xsi:type="ExternalizedMapping">
        <Property Name="ConfigRoot" />
        <Property Name="ExposureTime" DisplayName="ExposureTime" Description="Camera exposure in microseconds, in place of rig.yml's; at most the trigger period less 1,000 (19,000 at 50 Hz), or the workflow stops at Start. Stays set for later runs until cleared. Blank: rig.yml's camera exposureTime." />
        <Property Name="Gain" DisplayName="Gain" Description="Camera gain in dB, in place of rig.yml's; not recorded in the session. Stays set for later runs until cleared. Blank: rig.yml's camera gain." />
        <Property Name="Binning" DisplayName="Binning" Description="Camera binning, 1 for full resolution, in place of rig.yml's. Stays set for later runs until cleared. Blank: rig.yml's camera binning." />
      </Expression>
      <Expression xsi:type="GroupWorkflow">
        <Name>RigConfig</Name>
        <Description>Reads &lt;ConfigRoot&gt;\&lt;MACHINE-NAME&gt;\rig.yml once, into the RigConfig subject, then takes out the two devices this workflow drives by name, each into a subject of that name: BehaviorBoard-Main (behaviorBoard: main:) and Camera-Box (camera: box:). Each subject holds the device's Name and its Settings from rig.yml; the name is typed once, in RigDevice, and the device's files take theirs from the subject's Name, so the entry read and the files written cannot disagree. A second camera is another RigDevice and subject, such as Camera-Face. rig.yml is where each name is bound to its hardware (port, serial number); the name is what the data is called. Fails at startup if the machine has no directory or file, or if rig.yml has no entry by either name, saying which entries it has; other entries are ignored. The camera's ExposureTime, Gain and Binning can be set for one run from this workflow's properties (CameraOverrides); blank keeps rig.yml's, and Camera-Box carries the values in use, so the camera and the CSV's ExposureTime column agree. ExposureFitsTrigger then stops the workflow at Start if the exposure in use, plus 1000 us for the camera, is longer than the board's Trigger0 period (19,000 us at 50 Hz): the camera would skip triggers and every frame would get the wrong time.</Description>
        <Workflow>
          <Nodes>
            <Expression xsi:type="ExternalizedMapping">
              <Property Name="ConfigRoot" DisplayName="ConfigRoot" Description="The root under which each machine has its own configuration directory, &lt;ConfigRoot&gt;\&lt;MACHINE-NAME&gt;\rig.yml." />
            </Expression>
            <Expression xsi:type="Combinator">
              <Combinator xsi:type="orc:ResolveRigConfigDirectory">
              <orc:ConfigRoot>C:\Coen-Lab-Local\RigConfigs</orc:ConfigRoot>
            </Combinator>
            </Expression>
            <Expression xsi:type="IncludeWorkflow" Path="OpenRigs.Core:ReadRigConfig.bonsai">
              <FileName>rig.yml</FileName>
            </Expression>
            <Expression xsi:type="ext:DeserializeFromYaml">
              <ext:Type xsi:type="TypeMapping" TypeArguments="ext:UclOpenCoenBehaviourBoxRig" />
            </Expression>
            <Expression xsi:type="Combinator">
              <Combinator xsi:type="rx:Take">
              <rx:Count>1</rx:Count>
            </Combinator>
            </Expression>
            <Expression xsi:type="rx:AsyncSubject">
              <Name>RigConfig</Name>
            </Expression>
            <Expression xsi:type="MemberSelector">
              <Selector>BehaviorBoard</Selector>
            </Expression>
            <Expression xsi:type="Combinator">
              <Combinator xsi:type="ext:RigDevice">
                <ext:Name>BehaviorBoard-Main</ext:Name>
              </Combinator>
            </Expression>
            <Expression xsi:type="rx:AsyncSubject">
              <Name>BehaviorBoard-Main</Name>
            </Expression>
            <Expression xsi:type="MemberSelector">
              <Selector>Camera</Selector>
            </Expression>
            <Expression xsi:type="Combinator">
              <Combinator xsi:type="ext:RigDevice">
                <ext:Name>Camera-Box</ext:Name>
              </Combinator>
            </Expression>
            <Expression xsi:type="rx:AsyncSubject">
              <Name>Camera-Box</Name>
            </Expression>
            <Expression xsi:type="ExternalizedMapping">
              <Property Name="ExposureTime" />
              <Property Name="Gain" />
              <Property Name="Binning" />
            </Expression>
            <Expression xsi:type="Combinator">
              <Combinator xsi:type="ext:CameraOverrides">
                <ext:ExposureTime xsi:nil="true" />
                <ext:Gain xsi:nil="true" />
                <ext:Binning xsi:nil="true" />
              </Combinator>
            </Expression>
            <Expression xsi:type="SubscribeSubject">
              <Name>BehaviorBoard-Main</Name>
            </Expression>
            <Expression xsi:type="Combinator">
              <Combinator xsi:type="rx:Zip" />
            </Expression>
            <Expression xsi:type="Combinator">
              <Combinator xsi:type="ext:ExposureFitsTrigger">
                <ext:TriggerOutput>0</ext:TriggerOutput>
                <ext:MarginMicroseconds>1000</ext:MarginMicroseconds>
              </Combinator>
            </Expression>
          </Nodes>
          <Edges>
            <Edge From="0" To="1" Label="Source1" />
            <Edge From="1" To="2" Label="Source1" />
            <Edge From="2" To="3" Label="Source1" />
            <Edge From="3" To="4" Label="Source1" />
            <Edge From="4" To="5" Label="Source1" />
            <Edge From="5" To="6" Label="Source1" />
            <Edge From="6" To="7" Label="Source1" />
            <Edge From="7" To="8" Label="Source1" />
            <Edge From="5" To="9" Label="Source1" />
            <Edge From="9" To="10" Label="Source1" />
            <Edge From="10" To="13" Label="Source1" />
            <Edge From="12" To="13" Label="Source2" />
            <Edge From="13" To="15" Label="Source1" />
            <Edge From="14" To="15" Label="Source2" />
            <Edge From="15" To="16" Label="Source1" />
            <Edge From="16" To="11" Label="Source1" />
          </Edges>
        </Workflow>
      </Expression>
      <Expression xsi:type="ExternalizedMapping">
        <Property Name="SubjectId" />
        <Property Name="SessionId" />
      </Expression>
      <Expression xsi:type="GroupWorkflow">
        <Name>Initialization</Name>
        <Description>The session controller (OpenRigs.Control, SessionControl): SubjectId and SessionId from this node's properties or the command line (--property:SubjectId=...), the run length (whole minutes) as a parameter the controller may change until Go, and the control endpoint the rig agent talks to (TCP 5561). The workflow starts into ready mode: board connected, camera armed and streaming, nothing recorded, waiting for Go. At Go the IDs and the run length are checked once and published as RunSettings, which logging waits for; if an ID is empty or the run length is not 1 to 9999, the workflow stops with "Sequence contains no elements." and nothing is recorded. Stop from the controller ends the workflow through SessionStoppedException, closing every file.</Description>
        <Workflow>
          <Nodes>
            <Expression xsi:type="ExternalizedMapping">
              <Property Name="SubjectId" />
              <Property Name="SessionId" />
            </Expression>
            <Expression xsi:type="IncludeWorkflow" Path="OpenRigs.Control:SessionControl.bonsai">
              <SubjectId />
              <SessionId />
              <ControlEndpoint>@tcp://127.0.0.1:5561</ControlEndpoint>
              <Parameters>
                <Parameter>
                  <Name>RunLengthMins</Name>
                  <Value>30</Value>
                  <Description>How long to record, in whole minutes (1 to 9999).</Description>
                </Parameter>
              </Parameters>
              <Commands />
            </Expression>
            <Expression xsi:type="SubscribeSubject">
              <Name>SessionGo</Name>
            </Expression>
            <Expression xsi:type="MemberSelector">
              <Selector>SubjectId</Selector>
            </Expression>
            <Expression xsi:type="SubscribeSubject">
              <Name>SessionGo</Name>
            </Expression>
            <Expression xsi:type="MemberSelector">
              <Selector>SessionId</Selector>
            </Expression>
            <Expression xsi:type="SubscribeSubject">
              <Name>SessionGo</Name>
            </Expression>
            <Expression xsi:type="Combinator">
              <Combinator xsi:type="orcl:ParameterValue">
                <orcl:Name>RunLengthMins</orcl:Name>
              </Combinator>
            </Expression>
            <Expression xsi:type="scr:ExpressionTransform">
              <scr:Name>RunLengthToInt</scr:Name>
              <scr:Expression>Convert.ToInt32(it)</scr:Expression>
            </Expression>
            <Expression xsi:type="Combinator">
              <Combinator xsi:type="rx:Zip" />
            </Expression>
            <Expression xsi:type="Combinator">
              <Combinator xsi:type="rx:Take">
                <rx:Count>1</rx:Count>
              </Combinator>
            </Expression>
            <Expression xsi:type="rx:Condition">
              <Name>RunSettingsValid</Name>
              <Description>Subject and session given, and the run length from 1 to 9999 minutes.</Description>
              <Workflow>
                <Nodes>
                  <Expression xsi:type="WorkflowInput">
                    <Name>Source1</Name>
                  </Expression>
                  <Expression xsi:type="scr:ExpressionTransform">
                    <scr:Expression>Item1.Trim().Length &gt; 0 &amp;&amp; Item2.Trim().Length &gt; 0 &amp;&amp; Item3 &gt;= 1 &amp;&amp; Item3 &lt;= 9999</scr:Expression>
                  </Expression>
                  <Expression xsi:type="WorkflowOutput" />
                </Nodes>
                <Edges>
                  <Edge From="0" To="1" Label="Source1" />
                  <Edge From="1" To="2" Label="Source1" />
                </Edges>
              </Workflow>
            </Expression>
            <Expression xsi:type="Combinator">
              <Combinator xsi:type="rx:First" />
            </Expression>
            <Expression xsi:type="rx:AsyncSubject">
              <Name>RunSettings</Name>
            </Expression>
          </Nodes>
          <Edges>
            <Edge From="0" To="1" Label="Source1" />
            <Edge From="2" To="3" Label="Source1" />
            <Edge From="3" To="9" Label="Source1" />
            <Edge From="4" To="5" Label="Source1" />
            <Edge From="5" To="9" Label="Source2" />
            <Edge From="6" To="7" Label="Source1" />
            <Edge From="7" To="8" Label="Source1" />
            <Edge From="8" To="9" Label="Source3" />
            <Edge From="9" To="10" Label="Source1" />
            <Edge From="10" To="11" Label="Source1" />
            <Edge From="11" To="12" Label="Source1" />
            <Edge From="12" To="13" Label="Source1" />
          </Edges>
        </Workflow>
      </Expression>
      <Expression xsi:type="GroupWorkflow">
        <Name>Hardware</Name>
        <Description>The Harp Behavior board (running wheel encoder, camera trigger) and the camera. Each device takes its settings from its own entry in rig.yml, through the subject RigConfig publishes under its name (BehaviorBoard-Main, Camera-Box).</Description>
        <Workflow>
          <Nodes>
            <Expression xsi:type="GroupWorkflow">
              <Name>BehaviorBoard</Name>
              <Description>Harp Behavior board and the camera trigger on Trigger0 from OpenRigs.Devices, and the running wheel's encoder on port 2 (inline, in Position mode, logged raw). Clock sets the board's clock to UTC when it connects. Triggers start 5 s after RigConfig (at Start, before Go), so the camera is armed first and the preview streams in ready mode.</Description>
              <Workflow>
                <Nodes>
                  <Expression xsi:type="SubscribeSubject">
                    <Name>BehaviorBoard-Main</Name>
                  </Expression>
                  <Expression xsi:type="PropertyMapping">
                    <PropertyMappings>
                      <Property Name="PortName" Selector="Settings.PortName" />
                    </PropertyMappings>
                  </Expression>
                  <Expression xsi:type="IncludeWorkflow" Path="OpenRigs.Devices:BehaviorBoard.BehaviorBoard.bonsai">
                    <CommandsSubjectName>BehaviorCommands</CommandsSubjectName>
                    <PortName>COMx</PortName>
                    <DumpRegisters>true</DumpRegisters>
                    <Heartbeat>Enabled</Heartbeat>
                    <EventsSubjectName>BehaviorEvents</EventsSubjectName>
                  </Expression>
                  <Expression xsi:type="GroupWorkflow">
                    <Name>RunningWheel</Name>
                    <Description>Sets up the running wheel's encoder on port 2 in Position mode, as av-dome does, so the board's AnalogData (register 44) carries the absolute encoder count, logged raw. The OpenRigs.Devices RunningWheel include sets Displacement and then differences and accumulates it, which yields a speed sample rather than a distance; distance is computed offline from the raw count with countsPerRev and wheelDiameterMm in rig.yml.</Description>
                    <Workflow>
                      <Nodes>
                        <Expression xsi:type="beh:CreateMessage">
                          <harp:MessageType>Write</harp:MessageType>
                          <harp:Payload xsi:type="beh:CreateEnableEncodersPayload">
                            <beh:EnableEncoders>EncoderPort2</beh:EnableEncoders>
                          </harp:Payload>
                        </Expression>
                        <Expression xsi:type="beh:CreateMessage">
                          <harp:MessageType>Write</harp:MessageType>
                          <harp:Payload xsi:type="beh:CreateEncoderModePayload">
                            <beh:EncoderMode>Position</beh:EncoderMode>
                          </harp:Payload>
                        </Expression>
                        <Expression xsi:type="beh:CreateMessage">
                          <harp:MessageType>Write</harp:MessageType>
                          <harp:Payload xsi:type="beh:CreateEncoderResetPayload">
                            <beh:EncoderReset>EncoderPort2</beh:EncoderReset>
                          </harp:Payload>
                        </Expression>
                        <Expression xsi:type="Combinator">
                          <Combinator xsi:type="rx:Merge" />
                        </Expression>
                        <Expression xsi:type="ExternalizedMapping">
                          <Property Name="Name" DisplayName="CommandsSubjectName" Description="The name of the Subject that carries command messages for a specific behavior device" Category="Subjects" />
                        </Expression>
                        <Expression xsi:type="MulticastSubject">
                          <Name>BehaviorCommands</Name>
                        </Expression>
                        <Expression xsi:type="ExternalizedMapping">
                          <Property Name="Name" DisplayName="EventsSubjectName" Description="The name of the Subject that carries event messages from a specific behavior device" Category="Subjects" />
                        </Expression>
                        <Expression xsi:type="SubscribeSubject">
                          <Name>BehaviorEvents</Name>
                        </Expression>
                        <Expression xsi:type="Combinator">
                          <Combinator xsi:type="rx:SubscribeWhen" />
                        </Expression>
                      </Nodes>
                      <Edges>
                        <Edge From="0" To="3" Label="Source1" />
                        <Edge From="1" To="3" Label="Source2" />
                        <Edge From="2" To="3" Label="Source3" />
                        <Edge From="3" To="5" Label="Source1" />
                        <Edge From="4" To="5" Label="Source2" />
                        <Edge From="5" To="8" Label="Source1" />
                        <Edge From="6" To="7" Label="Source1" />
                        <Edge From="7" To="8" Label="Source2" />
                      </Edges>
                    </Workflow>
                  </Expression>
                  <Expression xsi:type="SubscribeSubject">
                    <Name>BehaviorBoard-Main</Name>
                  </Expression>
                  <Expression xsi:type="PropertyMapping">
                    <PropertyMappings>
                      <Property Name="Trigger0Frequency" Selector="Settings.CameraTriggerController.Trigger0Frequency" />
                      <Property Name="Trigger1Frequency" Selector="Settings.CameraTriggerController.Trigger1Frequency" />
                    </PropertyMappings>
                  </Expression>
                  <Expression xsi:type="IncludeWorkflow" Path="OpenRigs.Devices:BehaviorBoard.CameraTriggerController.bonsai">
                    <Trigger0Frequency>50</Trigger0Frequency>
                    <Trigger1Frequency>50</Trigger1Frequency>
                    <BehaviorCommandsSubjectName>BehaviorCommands</BehaviorCommandsSubjectName>
                    <BehaviorEventsSubjectName>BehaviorEvents</BehaviorEventsSubjectName>
                    <Camera0TriggerEventsSubjectName>Camera0TriggerEvents</Camera0TriggerEventsSubjectName>
                    <Camera1TriggerEventsSubjectName>Camera1TriggerEvents</Camera1TriggerEventsSubjectName>
                  </Expression>
                  <Expression xsi:type="SubscribeSubject">
                    <Name>RigConfig</Name>
                  </Expression>
                  <Expression xsi:type="Combinator">
                    <Combinator xsi:type="BooleanProperty">
                    <Value>true</Value>
                  </Combinator>
                  </Expression>
                  <Expression xsi:type="Combinator">
                    <Combinator xsi:type="rx:Delay">
                    <rx:DueTime>PT5S</rx:DueTime>
                  </Combinator>
                  </Expression>
                  <Expression xsi:type="MulticastSubject">
                    <Name>StartCameras</Name>
                  </Expression>
                  <Expression xsi:type="GroupWorkflow">
                    <Name>Clock</Name>
                    <Description>Sets the board's clock to the PC's UTC time (SynchronizeTimestamp, whole seconds) as soon as the board sends its first message, and publishes the board's reply as BoardClockSet. Without it the board counts from power-on, and Harp timestamps, the CSV Seconds column and every file name follow that count (1904-01-04T17-00-00 and so on). The board's own open-time register dump comes before this write and is not logged; Logging waits for BoardClockSet before it logs the board and asks for the dump it keeps. If the board's reply has not come 10 s after Start, Watchdog stops the workflow with a message saying so, rather than record a whole session with no board files; triggers start 5 s after Start, so the session folder then holds a few seconds of video and CSV and no board files. (4 s stopped every run: Watchdog's time counts from the workflow's subscription, before the config and camera are up. In 35 sessions on 30 Oct 2026 the board's log began about 3.9 s before the first trigger, so the clock is set well before any frame.)</Description>
                    <Workflow>
                      <Nodes>
                        <Expression xsi:type="SubscribeSubject">
                          <Name>BehaviorEvents</Name>
                        </Expression>
                        <Expression xsi:type="Combinator">
                          <Combinator xsi:type="rx:Take">
                            <rx:Count>1</rx:Count>
                          </Combinator>
                        </Expression>
                        <Expression xsi:type="Combinator">
                          <Combinator xsi:type="harp:SynchronizeTimestamp" />
                        </Expression>
                        <Expression xsi:type="MulticastSubject">
                          <Name>BehaviorCommands</Name>
                        </Expression>
                        <Expression xsi:type="SubscribeSubject">
                          <Name>BehaviorEvents</Name>
                        </Expression>
                        <Expression xsi:type="harp:FilterRegister">
                          <harp:FilterType>Include</harp:FilterType>
                          <harp:Register xsi:type="harp:TimestampSeconds" />
                        </Expression>
                        <Expression xsi:type="Combinator">
                          <Combinator xsi:type="harp:FilterMessageType">
                            <harp:FilterType>Include</harp:FilterType>
                            <harp:MessageType>Write</harp:MessageType>
                          </Combinator>
                        </Expression>
                        <Expression xsi:type="Combinator">
                          <Combinator xsi:type="rx:Take">
                            <rx:Count>1</rx:Count>
                          </Combinator>
                        </Expression>
                        <Expression xsi:type="rx:AsyncSubject">
                          <Name>BoardClockSet</Name>
                        </Expression>
                        <Expression xsi:type="Combinator">
                          <Combinator xsi:type="ext:Watchdog">
                            <ext:DueTime>PT10S</ext:DueTime>
                            <ext:Message>The board did not confirm within 10 s of Start that its clock was set, so nothing from the board is logged. Either its messages are not reaching the PC or the board is not responding. Check the board's USB cable and power (switch it off and on if it is powered), then Start again. The session folder holds a few seconds of video and CSV and no board files.</ext:Message>
                          </Combinator>
                        </Expression>
                      </Nodes>
                      <Edges>
                        <Edge From="0" To="1" Label="Source1" />
                        <Edge From="1" To="2" Label="Source1" />
                        <Edge From="2" To="3" Label="Source1" />
                        <Edge From="4" To="5" Label="Source1" />
                        <Edge From="5" To="6" Label="Source1" />
                        <Edge From="6" To="9" Label="Source1" />
                        <Edge From="9" To="7" Label="Source1" />
                        <Edge From="7" To="8" Label="Source1" />
                      </Edges>
                    </Workflow>
                  </Expression>
                </Nodes>
                <Edges>
                  <Edge From="0" To="1" Label="Source1" />
                  <Edge From="1" To="2" Label="Source1" />
                  <Edge From="4" To="5" Label="Source1" />
                  <Edge From="5" To="6" Label="Source1" />
                  <Edge From="7" To="8" Label="Source1" />
                  <Edge From="8" To="9" Label="Source1" />
                  <Edge From="9" To="10" Label="Source1" />
                </Edges>
              </Workflow>
            </Expression>
            <Expression xsi:type="GroupWorkflow">
              <Name>Camera</Name>
              <Description>Frames paired with Harp trigger times. Triggers are Event messages only: the CameraTriggerController subject also carries the register-dump Read reply, which is not a trigger. OpenRigs.Video TriggeredSpinnaker, given the triggers, copies FrameID and Timestamp inside the camera callback, fills FrameID gaps and then pairs frames with triggers, so a dropped frame does not shift later times. Subscribed once rig.yml is read (RigConfig), at Start and before Go, so the preview streams in ready mode; the first frame reports Ready to the controller. Watchdog stops the workflow with a message of its own if no frame arrives for 15 s (usually the trigger cable).</Description>
              <Workflow>
                <Nodes>
                  <Expression xsi:type="SubscribeSubject">
                    <Name>Camera-Box</Name>
                  </Expression>
                  <Expression xsi:type="PropertyMapping">
                    <PropertyMappings>
                      <Property Name="SerialNumber" Selector="Settings.SerialNumber" />
                      <Property Name="ExposureTime" Selector="Settings.ExposureTime" />
                      <Property Name="Gain" Selector="Settings.Gain" />
                      <Property Name="Binning" Selector="Settings.Binning" />
                    </PropertyMappings>
                  </Expression>
                  <Expression xsi:type="SubscribeSubject">
                    <Name>BehaviorEvents</Name>
                  </Expression>
                  <Expression xsi:type="Combinator">
                    <Combinator xsi:type="harp:FilterMessageType">
                    <harp:FilterType>Include</harp:FilterType>
                    <harp:MessageType>Event</harp:MessageType>
                  </Combinator>
                  </Expression>
                  <Expression xsi:type="beh:Parse">
                    <harp:Register xsi:type="beh:TimestampedCamera0Frame" />
                  </Expression>
                  <Expression xsi:type="Combinator">
                    <Combinator xsi:type="orv:TriggeredSpinnaker">
                    <spk:Index xsi:nil="true" />
                    <spk:SerialNumber />
                    <spk:ColorProcessing>Default</spk:ColorProcessing>
                    <orv:ExposureTime>10000</orv:ExposureTime>
                    <orv:Gain>5</orv:Gain>
                    <orv:Binning>1</orv:Binning>
                  </Combinator>
                  </Expression>
                  <Expression xsi:type="Combinator">
                    <Combinator xsi:type="ext:Watchdog">
                      <ext:DueTime>PT15S</ext:DueTime>
                      <ext:Message>No frame from the camera for 15 s, so the run was stopped. Usually the trigger cable from the board's output 0 to the camera; also check the camera's USB cable. Then Start again.</ext:Message>
                    </Combinator>
                  </Expression>
                  <Expression xsi:type="SubscribeSubject">
                    <Name>RigConfig</Name>
                  </Expression>
                  <Expression xsi:type="Combinator">
                    <Combinator xsi:type="rx:SubscribeWhen" />
                  </Expression>
                  <Expression xsi:type="rx:PublishSubject">
                    <Name>FrameEvents</Name>
                  </Expression>
                  <Expression xsi:type="SubscribeSubject">
                    <Name>FrameEvents</Name>
                  </Expression>
                  <Expression xsi:type="Combinator">
                    <Combinator xsi:type="rx:Take">
                      <rx:Count>1</rx:Count>
                    </Combinator>
                  </Expression>
                  <Expression xsi:type="Combinator">
                    <Combinator xsi:type="orcl:ReportPhase">
                      <orcl:Phase>Ready</orcl:Phase>
                    </Combinator>
                  </Expression>
                </Nodes>
                <Edges>
                  <Edge From="0" To="1" Label="Source1" />
                  <Edge From="2" To="3" Label="Source1" />
                  <Edge From="3" To="4" Label="Source1" />
                  <Edge From="4" To="5" Label="Source1" />
                  <Edge From="1" To="5" Label="Source2" />
                  <Edge From="5" To="6" Label="Source1" />
                  <Edge From="6" To="8" Label="Source1" />
                  <Edge From="7" To="8" Label="Source2" />
                  <Edge From="8" To="9" Label="Source1" />
                  <Edge From="10" To="11" Label="Source1" />
                  <Edge From="11" To="12" Label="Source1" />
                </Edges>
              </Workflow>
            </Expression>
          </Nodes>
          <Edges />
        </Workflow>
      </Expression>
      <Expression xsi:type="GroupWorkflow">
        <Name>Logging</Name>
        <Description>Waits for RunSettings, then LogController creates the session folder (PathPrefix). Once it exists: the video and its CSV, and, once the board's clock is also set (BoardClockSet, from Hardware > BehaviorBoard > Clock), every Behavior board message and a register dump so the board log records the board's settings. The board's own open-time dump, before the clock is set, is not logged. Each device logs into a folder of its own name, taken from its subject's Name (BehaviorBoard-Main, Camera-Box), as &lt;Name&gt;_&lt;DateTime&gt; files in one-hour chunks on the board's Harp clock (the Open Rigs logging spec).</Description>
        <Workflow>
          <Nodes>
            <Expression xsi:type="SubscribeSubject">
              <Name>RunSettings</Name>
            </Expression>
            <Expression xsi:type="SubscribeSubject">
              <Name>RigConfig</Name>
            </Expression>
            <Expression xsi:type="Combinator">
              <Combinator xsi:type="rx:Zip" />
            </Expression>
            <Expression xsi:type="PropertyMapping">
              <PropertyMappings>
                <Property Name="SubjectId" Selector="Item1.Item1" />
                <Property Name="SessionId" Selector="Item1.Item2" />
                <Property Name="Path" Selector="Item2.RootPath" />
              </PropertyMappings>
            </Expression>
            <Expression xsi:type="IncludeWorkflow" Path="OpenRigs.Logging:LogController.bonsai">
              <SubjectId>CHANGE-ME</SubjectId>
              <SessionId>CHANGE-ME</SessionId>
              <Path>C:\Data</Path>
            </Expression>
            <Expression xsi:type="Combinator">
              <Combinator xsi:type="rx:DelaySubscription">
              <rx:DueTime>PT1S</rx:DueTime>
            </Combinator>
            </Expression>
            <Expression xsi:type="SubscribeSubject">
              <Name>RunSettings</Name>
            </Expression>
            <Expression xsi:type="Combinator">
              <Combinator xsi:type="rx:SubscribeWhen" />
            </Expression>
            <Expression xsi:type="SubscribeSubject">
              <Name>FrameEvents</Name>
            </Expression>
            <Expression xsi:type="GroupWorkflow">
              <Name>RecordVideo</Name>
              <Description>Subscribed only once PathPrefix exists: Take reads its Count, and the writers may read FileName, at subscription. Records the run length's worth of frames (RunLengthToFrames), split into one-hour chunks on the frames' Harp time (GroupByTime, as the board's log is), each chunk to &lt;Name&gt;\&lt;Name&gt;_&lt;DateTime&gt;.avi and .csv, Name being the camera's from its subject (Camera-Box), named by OpenRigs.Logging's FormatFileName after the chunk's start as the board's files are. CSV columns, as av-dome writes for its cameras: Seconds (Harp time of the frame's trigger), Timestamp and FrameID (camera), ExposureTime. A run crossing the hour gives two pairs; one ffmpeg closes and the next opens there. The video is H.264 through FFmpeg on Intel Quick Sync (Bonsai.Vision's VideoWriter, which av-dome and LogVideo use, fell behind on the N150 and crashed long sessions). ExposureTime is the configured value, because OpenRigs.Video's frame does not carry the camera's. Wait for ffmpeg.exe to exit before closing Bonsai. SampleInterval here samples the recorded frames, 5 a second; the editor's preview window (config\main.layout) is on LiveView's SampleInterval instead, which takes every camera frame from Start, so it shows the camera in ready mode. RecordedFrames carries the frames after the video writer, for LiveView's elapsed stream; publishing it from Logging instead stopped the preview window from opening (30 Oct 2026, cause not found).</Description>
              <Workflow>
                <Nodes>
                  <Expression xsi:type="WorkflowInput">
                    <Name>Source1</Name>
                  </Expression>
                  <Expression xsi:type="GroupWorkflow">
                    <Name>RunLengthToFrames</Name>
                    <Description>Frames to record: run length (minutes) x 60 x the camera trigger frequency of BehaviorBoard-Main in rig.yml.</Description>
                    <Workflow>
                      <Nodes>
                        <Expression xsi:type="SubscribeSubject">
                          <Name>RunSettings</Name>
                        </Expression>
                        <Expression xsi:type="SubscribeSubject">
                          <Name>BehaviorBoard-Main</Name>
                        </Expression>
                        <Expression xsi:type="Combinator">
                          <Combinator xsi:type="rx:Zip" />
                        </Expression>
                        <Expression xsi:type="scr:ExpressionTransform">
                          <scr:Name>RunLengthToFrames</scr:Name>
                          <scr:Expression>Convert.ToInt32(Convert.ToDouble(Item1.Item3) * 60.0 * Item2.Settings.CameraTriggerController.Trigger0Frequency)</scr:Expression>
                        </Expression>
                        <Expression xsi:type="WorkflowOutput" />
                      </Nodes>
                      <Edges>
                        <Edge From="0" To="2" Label="Source1" />
                        <Edge From="1" To="2" Label="Source2" />
                        <Edge From="2" To="3" Label="Source1" />
                        <Edge From="3" To="4" Label="Source1" />
                      </Edges>
                    </Workflow>
                  </Expression>
                  <Expression xsi:type="PropertyMapping">
                    <PropertyMappings>
                      <Property Name="Count" />
                    </PropertyMappings>
                  </Expression>
                  <Expression xsi:type="Combinator">
                    <Combinator xsi:type="rx:Take">
                    <rx:Count>3000</rx:Count>
                  </Combinator>
                  </Expression>
                  <Expression xsi:type="Combinator">
                    <Combinator xsi:type="orc:GroupByTime">
                      <orc:ChunkSize>1</orc:ChunkSize>
                    </Combinator>
                  </Expression>
                  <Expression xsi:type="rx:CreateObservable">
                    <Name>CameraChunk</Name>
                    <Description>One chunk's frames: the video and its CSV, each named after the chunk's start (the group's Key), as OpenRigs.Logging's LogVideo does.</Description>
                    <Workflow>
                      <Nodes>
                        <Expression xsi:type="WorkflowInput">
                          <Name>Source1</Name>
                        </Expression>
                        <Expression xsi:type="rx:AsyncSubject">
                          <Name>Chunk</Name>
                        </Expression>
                        <Expression xsi:type="SubscribeSubject">
                          <Name>Chunk</Name>
                        </Expression>
                        <Expression xsi:type="Combinator">
                          <Combinator xsi:type="rx:Merge" />
                        </Expression>
                        <Expression xsi:type="SubscribeSubject">
                          <Name>Chunk</Name>
                        </Expression>
                        <Expression xsi:type="MemberSelector">
                          <Selector>Key</Selector>
                        </Expression>
                        <Expression xsi:type="IncludeWorkflow" Path="OpenRigs.Logging:FormatFileName.bonsai">
                          <Name>UNMAPPED</Name>
                          <Extension>avi</Extension>
                        </Expression>
                        <Expression xsi:type="PropertyMapping">
                          <PropertyMappings>
                            <Property Name="FileName" />
                          </PropertyMappings>
                        </Expression>
                        <Expression xsi:type="SubscribeSubject">
                          <Name>BehaviorBoard-Main</Name>
                        </Expression>
                        <Expression xsi:type="PropertyMapping">
                          <PropertyMappings>
                            <Property Name="FrameRate" Selector="Settings.CameraTriggerController.Trigger0Frequency" />
                          </PropertyMappings>
                        </Expression>
                        <Expression xsi:type="MemberSelector">
                          <Selector>Value.Image</Selector>
                        </Expression>
                        <Expression xsi:type="Combinator">
                          <Combinator xsi:type="ffm:VideoWriter">
                            <ffm:FileName />
                            <ffm:Suffix>None</ffm:Suffix>
                            <ffm:Overwrite>false</ffm:Overwrite>
                            <ffm:FrameRate>50</ffm:FrameRate>
                            <ffm:OutputArguments>-loglevel error -nostats -c:v h264_qsv -preset veryfast -global_quality 20 -bf 0 -pix_fmt nv12</ffm:OutputArguments>
                          </Combinator>
                        </Expression>
                        <Expression xsi:type="WorkflowOutput" />
                        <Expression xsi:type="MemberSelector">
                          <Selector>Seconds</Selector>
                        </Expression>
                        <Expression xsi:type="MemberSelector">
                          <Selector>Value.ChunkData.Timestamp</Selector>
                        </Expression>
                        <Expression xsi:type="MemberSelector">
                          <Selector>Value.ChunkData.FrameID</Selector>
                        </Expression>
                        <Expression xsi:type="Combinator">
                          <Combinator xsi:type="rx:Zip" />
                        </Expression>
                        <Expression xsi:type="SubscribeSubject">
                          <Name>Camera-Box</Name>
                        </Expression>
                        <Expression xsi:type="MemberSelector">
                          <Selector>Settings.ExposureTime</Selector>
                        </Expression>
                        <Expression xsi:type="Combinator">
                          <Combinator xsi:type="rx:WithLatestFrom" />
                        </Expression>
                        <Expression xsi:type="scr:ExpressionTransform">
                          <scr:Expression>new(
                  Item1.Item1 as Seconds,
                  Item1.Item2 as Timestamp,
                  Item1.Item3 as FrameID,
                  Item2 as ExposureTime)</scr:Expression>
                        </Expression>
                        <Expression xsi:type="SubscribeSubject">
                          <Name>Chunk</Name>
                        </Expression>
                        <Expression xsi:type="MemberSelector">
                          <Selector>Key</Selector>
                        </Expression>
                        <Expression xsi:type="IncludeWorkflow" Path="OpenRigs.Logging:FormatFileName.bonsai">
                          <Name>UNMAPPED</Name>
                          <Extension>csv</Extension>
                        </Expression>
                        <Expression xsi:type="PropertyMapping">
                          <PropertyMappings>
                            <Property Name="FileName" />
                          </PropertyMappings>
                        </Expression>
                        <Expression xsi:type="io:CsvWriter">
                          <io:FileName />
                          <io:Append>false</io:Append>
                          <io:Overwrite>false</io:Overwrite>
                          <io:Suffix>None</io:Suffix>
                          <io:IncludeHeader>true</io:IncludeHeader>
                          <io:Selector />
                        </Expression>
                        <Expression xsi:type="SubscribeSubject">
                          <Name>Camera-Box</Name>
                        </Expression>
                        <Expression xsi:type="PropertyMapping">
                          <PropertyMappings>
                            <Property Name="Name" Selector="Name" />
                          </PropertyMappings>
                        </Expression>
                        <Expression xsi:type="SubscribeSubject">
                          <Name>Camera-Box</Name>
                        </Expression>
                        <Expression xsi:type="PropertyMapping">
                          <PropertyMappings>
                            <Property Name="Name" Selector="Name" />
                          </PropertyMappings>
                        </Expression>
                      </Nodes>
                      <Edges>
                        <Edge From="0" To="1" Label="Source1" />
                        <Edge From="2" To="3" Label="Source1" />
                        <Edge From="3" To="10" Label="Source1" />
                        <Edge From="10" To="11" Label="Source1" />
                        <Edge From="4" To="5" Label="Source1" />
                        <Edge From="5" To="6" Label="Source1" />
                        <Edge From="6" To="7" Label="Source1" />
                        <Edge From="7" To="11" Label="Source2" />
                        <Edge From="8" To="9" Label="Source1" />
                        <Edge From="9" To="11" Label="Source3" />
                        <Edge From="11" To="12" Label="Source1" />
                        <Edge From="3" To="13" Label="Source1" />
                        <Edge From="3" To="14" Label="Source1" />
                        <Edge From="3" To="15" Label="Source1" />
                        <Edge From="13" To="16" Label="Source1" />
                        <Edge From="14" To="16" Label="Source2" />
                        <Edge From="15" To="16" Label="Source3" />
                        <Edge From="17" To="18" Label="Source1" />
                        <Edge From="16" To="19" Label="Source1" />
                        <Edge From="18" To="19" Label="Source2" />
                        <Edge From="19" To="20" Label="Source1" />
                        <Edge From="21" To="22" Label="Source1" />
                        <Edge From="22" To="23" Label="Source1" />
                        <Edge From="23" To="24" Label="Source1" />
                        <Edge From="20" To="25" Label="Source1" />
                        <Edge From="24" To="25" Label="Source2" />
                        <Edge From="26" To="27" Label="Source1" />
                        <Edge From="27" To="6" Label="Source2" />
                        <Edge From="28" To="29" Label="Source1" />
                        <Edge From="29" To="23" Label="Source2" />
                      </Edges>
                    </Workflow>
                  </Expression>
                  <Expression xsi:type="Combinator">
                    <Combinator xsi:type="rx:Switch" />
                  </Expression>
                  <Expression xsi:type="WorkflowOutput" />
                  <Expression xsi:type="MemberSelector">
                    <Selector>Value.Image</Selector>
                  </Expression>
                  <Expression xsi:type="Combinator">
                    <Combinator xsi:type="rx:SampleInterval">
                    <rx:Interval>PT0.2S</rx:Interval>
                  </Combinator>
                  </Expression>
                  <Expression xsi:type="rx:PublishSubject">
                    <Name>RecordedFrames</Name>
                  </Expression>
                </Nodes>
                <Edges>
                  <Edge From="0" To="3" Label="Source1" />
                  <Edge From="1" To="2" Label="Source1" />
                  <Edge From="2" To="3" Label="Source2" />
                  <Edge From="3" To="4" Label="Source1" />
                  <Edge From="4" To="5" Label="Source1" />
                  <Edge From="5" To="6" Label="Source1" />
                  <Edge From="6" To="7" Label="Source1" />
                  <Edge From="3" To="8" Label="Source1" />
                  <Edge From="8" To="9" Label="Source1" />
                  <Edge From="6" To="10" Label="Source1" />
                </Edges>
              </Workflow>
            </Expression>
            <Expression xsi:type="SubscribeSubject">
              <Name>PathPrefix</Name>
            </Expression>
            <Expression xsi:type="Combinator">
              <Combinator xsi:type="rx:SubscribeWhen" />
            </Expression>
            <Expression xsi:type="SubscribeSubject">
              <Name>BehaviorEvents</Name>
            </Expression>
            <Expression xsi:type="SubscribeSubject">
              <Name>PathPrefix</Name>
            </Expression>
            <Expression xsi:type="Combinator">
              <Combinator xsi:type="rx:SubscribeWhen" />
            </Expression>
            <Expression xsi:type="IncludeWorkflow" Path="OpenRigs.Logging:LogHarpDevice.bonsai">
              <LogName>UNMAPPED</LogName>
            </Expression>
            <Expression xsi:type="SubscribeSubject">
              <Name>PathPrefix</Name>
            </Expression>
            <Expression xsi:type="Combinator">
              <Combinator xsi:type="rx:Delay">
                <rx:DueTime>PT0.5S</rx:DueTime>
              </Combinator>
            </Expression>
            <Expression xsi:type="harp:CreateMessage">
              <harp:MessageType>Write</harp:MessageType>
              <harp:Payload xsi:type="harp:CreateOperationControlPayload">
                <harp:OperationMode>Active</harp:OperationMode>
                <harp:DumpRegisters>true</harp:DumpRegisters>
                <harp:MuteReplies>false</harp:MuteReplies>
                <harp:VisualIndicators>Off</harp:VisualIndicators>
                <harp:OperationLed>Off</harp:OperationLed>
                <harp:Heartbeat>Enabled</harp:Heartbeat>
              </harp:Payload>
            </Expression>
            <Expression xsi:type="MulticastSubject">
              <Name>BehaviorCommands</Name>
            </Expression>
            <Expression xsi:type="SubscribeSubject">
              <Name>BehaviorBoard-Main</Name>
            </Expression>
            <Expression xsi:type="PropertyMapping">
              <PropertyMappings>
                <Property Name="LogName" Selector="Name" />
              </PropertyMappings>
            </Expression>
            <Expression xsi:type="SubscribeSubject">
              <Name>BoardClockSet</Name>
            </Expression>
            <Expression xsi:type="Combinator">
              <Combinator xsi:type="rx:SubscribeWhen" />
            </Expression>
            <Expression xsi:type="SubscribeSubject">
              <Name>BoardClockSet</Name>
            </Expression>
            <Expression xsi:type="Combinator">
              <Combinator xsi:type="rx:SubscribeWhen" />
            </Expression>
            <Expression xsi:type="SubscribeSubject">
              <Name>PathPrefix</Name>
            </Expression>
            <Expression xsi:type="Combinator">
              <Combinator xsi:type="clm:WriteSessionManifest">
                <clm:IngestScript>coen-behaviour-box</clm:IngestScript>
                <clm:RigConfigPath>C:\Coen-Lab-Local\RigConfigs\%COMPUTERNAME%\rig.yml</clm:RigConfigPath>
              </Combinator>
            </Expression>
            <Expression xsi:type="SubscribeSubject">
              <Name>PathPrefix</Name>
            </Expression>
            <Expression xsi:type="Combinator">
              <Combinator xsi:type="orcl:ReportMetric">
                <orcl:Name>path</orcl:Name>
              </Combinator>
            </Expression>
            <Expression xsi:type="Combinator">
              <Combinator xsi:type="orcl:ReportPhase">
                <orcl:Phase>Recording</orcl:Phase>
              </Combinator>
            </Expression>
            <Expression xsi:type="Combinator">
              <Combinator xsi:type="rx:Count" />
            </Expression>
            <Expression xsi:type="Combinator">
              <Combinator xsi:type="orcl:ReportPhase">
                <orcl:Phase>Finished</orcl:Phase>
              </Combinator>
            </Expression>
          </Nodes>
          <Edges>
            <Edge From="0" To="2" Label="Source1" />
            <Edge From="1" To="2" Label="Source2" />
            <Edge From="2" To="3" Label="Source1" />
            <Edge From="3" To="4" Label="Source1" />
            <Edge From="4" To="5" Label="Source1" />
            <Edge From="5" To="7" Label="Source1" />
            <Edge From="6" To="7" Label="Source2" />
            <Edge From="8" To="9" Label="Source1" />
            <Edge From="9" To="11" Label="Source1" />
            <Edge From="10" To="11" Label="Source2" />
            <Edge From="12" To="23" Label="Source1" />
            <Edge From="22" To="23" Label="Source2" />
            <Edge From="23" To="14" Label="Source1" />
            <Edge From="13" To="14" Label="Source2" />
            <Edge From="14" To="15" Label="Source1" />
            <Edge From="16" To="25" Label="Source1" />
            <Edge From="24" To="25" Label="Source2" />
            <Edge From="25" To="17" Label="Source1" />
            <Edge From="17" To="18" Label="Source1" />
            <Edge From="18" To="19" Label="Source1" />
            <Edge From="20" To="21" Label="Source1" />
            <Edge From="21" To="15" Label="Source2" />
            <Edge From="26" To="27" Label="Source1" />
            <Edge From="11" To="27" Label="Source2" />
            <Edge From="28" To="29" Label="Source1" />
            <Edge From="29" To="30" Label="Source1" />
            <Edge From="11" To="31" Label="Source1" />
            <Edge From="31" To="32" Label="Source1" />
          </Edges>
        </Workflow>
      </Expression>
      <Expression xsi:type="GroupWorkflow">
        <Name>LiveView</Name>
        <Description>Streams the recording over ZeroMQ for the machines window's live view (OpenRigs.Streaming), publishing on every interface: data on TCP 5556, video on 5558. Every message carries RigId, the machine's name, and the session key sub-&lt;SubjectId&gt;/ses-&lt;SessionId&gt;_date-&lt;start&gt;, the session folder's own name (StreamController, inline, takes it from PathPrefix). Streams: video, the camera's frames at 5 per second, 320 x 240 JPEG, from Start (in ready mode too); elapsed, the seconds of video recorded so far (frames / trigger frequency), once a second; wheel, the raw encoder count from AnalogData, 10 times a second. A viewer only listens, and a slow or late one loses its own messages without slowing the rig; with none connected the messages are dropped. A port already in use (another workflow streaming) stops the workflow at Start with NetMQ's AddressAlreadyInUseException, before the camera is triggered.</Description>
        <Workflow>
          <Nodes>
            <Expression xsi:type="GroupWorkflow">
              <Name>StreamController</Name>
              <Description>OpenRigs.Streaming's StreamController (open-rigs 77094a4), inline so that the session key comes from the session folder LogController made (PathPrefix, through SessionKey) rather than from a date of its own taken at Start, which named a folder a second earlier than the real one. StreamIdentity is RigId, the machine's name (COMPUTERNAME), and the key. In ready mode, before the session folder exists, the key is "ready", so the preview streams from Start; once PathPrefix exists, about 1 s after Go, the key becomes the folder's (StreamIdentity replays its latest value to each message). The two publishers bind their ports at Start, as in the include. Swap back to the include once StreamController takes the session path.</Description>
              <Workflow>
                <Nodes>
                  <Expression xsi:type="SubscribeSubject">
                    <Name>PathPrefix</Name>
                  </Expression>
                  <Expression xsi:type="Combinator">
                    <Combinator xsi:type="ext:SessionKey" />
                  </Expression>
                  <Expression xsi:type="Combinator">
                    <Combinator xsi:type="io:GetEnvironmentVariable">
                      <io:Name>COMPUTERNAME</io:Name>
                    </Combinator>
                  </Expression>
                  <Expression xsi:type="Combinator">
                    <Combinator xsi:type="rx:CombineLatest" />
                  </Expression>
                  <Expression xsi:type="Combinator">
                    <Combinator xsi:type="rx:DistinctUntilChanged" />
                  </Expression>
                  <Expression xsi:type="rx:ReplaySubject">
                    <Name>StreamIdentity</Name>
                    <rx:BufferSize>1</rx:BufferSize>
                  </Expression>
                  <Expression xsi:type="rx:PublishSubject" TypeArguments="netmq:NetMQMessage">
                    <rx:Name>DataMessage</rx:Name>
                  </Expression>
                  <Expression xsi:type="Combinator">
                    <Combinator xsi:type="rx:ObserveOn">
                      <rx:Scheduler>NewThreadScheduler</rx:Scheduler>
                    </Combinator>
                  </Expression>
                  <Expression xsi:type="Combinator">
                    <Combinator xsi:type="zmq:Publisher">
                      <zmq:ConnectionString>@tcp://0.0.0.0:5556</zmq:ConnectionString>
                      <zmq:Topic />
                    </Combinator>
                  </Expression>
                  <Expression xsi:type="rx:PublishSubject" TypeArguments="netmq:NetMQMessage">
                    <rx:Name>VideoMessage</rx:Name>
                  </Expression>
                  <Expression xsi:type="Combinator">
                    <Combinator xsi:type="rx:ObserveOn">
                      <rx:Scheduler>NewThreadScheduler</rx:Scheduler>
                    </Combinator>
                  </Expression>
                  <Expression xsi:type="Combinator">
                    <Combinator xsi:type="zmq:Publisher">
                      <zmq:ConnectionString>@tcp://0.0.0.0:5558</zmq:ConnectionString>
                      <zmq:Topic />
                    </Combinator>
                  </Expression>
                  <Expression xsi:type="Combinator">
                    <Combinator xsi:type="StringProperty">
                      <Value>ready</Value>
                    </Combinator>
                  </Expression>
                  <Expression xsi:type="Combinator">
                    <Combinator xsi:type="rx:Merge" />
                  </Expression>
                </Nodes>
                <Edges>
                  <Edge From="0" To="1" Label="Source1" />
                  <Edge From="2" To="3" Label="Source1" />
                  <Edge From="1" To="13" Label="Source1" />
                  <Edge From="12" To="13" Label="Source2" />
                  <Edge From="13" To="3" Label="Source2" />
                  <Edge From="3" To="4" Label="Source1" />
                  <Edge From="4" To="5" Label="Source1" />
                  <Edge From="6" To="7" Label="Source1" />
                  <Edge From="7" To="8" Label="Source1" />
                  <Edge From="9" To="10" Label="Source1" />
                  <Edge From="10" To="11" Label="Source1" />
                </Edges>
              </Workflow>
            </Expression>
            <Expression xsi:type="SubscribeSubject">
              <Name>FrameEvents</Name>
            </Expression>
            <Expression xsi:type="IncludeWorkflow" Path="OpenRigs.Streaming:PackVideoMessage.bonsai">
              <StreamName>video</StreamName>
            </Expression>
            <Expression xsi:type="SubscribeSubject">
              <Name>RecordedFrames</Name>
            </Expression>
            <Expression xsi:type="Combinator">
              <Combinator xsi:type="rx:ElementIndex" />
            </Expression>
            <Expression xsi:type="MemberSelector">
              <Selector>Index</Selector>
            </Expression>
            <Expression xsi:type="Combinator">
              <Combinator xsi:type="rx:SampleInterval">
                <rx:Interval>PT1S</rx:Interval>
              </Combinator>
            </Expression>
            <Expression xsi:type="SubscribeSubject">
              <Name>BehaviorBoard-Main</Name>
            </Expression>
            <Expression xsi:type="Combinator">
              <Combinator xsi:type="rx:WithLatestFrom" />
            </Expression>
            <Expression xsi:type="scr:ExpressionTransform">
              <scr:Name>FramesToSeconds</scr:Name>
              <scr:Expression>(Item1 + 1) / Convert.ToDouble(Item2.Settings.CameraTriggerController.Trigger0Frequency)</scr:Expression>
            </Expression>
            <Expression xsi:type="IncludeWorkflow" Path="OpenRigs.Streaming:PackDataMessage.bonsai">
              <StreamName>elapsed</StreamName>
            </Expression>
            <Expression xsi:type="SubscribeSubject">
              <Name>BehaviorEvents</Name>
            </Expression>
            <Expression xsi:type="beh:Parse">
              <harp:Register xsi:type="beh:AnalogData" />
            </Expression>
            <Expression xsi:type="MemberSelector">
              <Selector>Encoder</Selector>
            </Expression>
            <Expression xsi:type="Combinator">
              <Combinator xsi:type="rx:SampleInterval">
                <rx:Interval>PT0.1S</rx:Interval>
              </Combinator>
            </Expression>
            <Expression xsi:type="IncludeWorkflow" Path="OpenRigs.Streaming:PackDataMessage.bonsai">
              <StreamName>wheel</StreamName>
            </Expression>
            <Expression xsi:type="MemberSelector">
              <Selector>Value.Image</Selector>
            </Expression>
            <Expression xsi:type="Combinator">
              <Combinator xsi:type="rx:SampleInterval">
                <rx:Interval>PT0.2S</rx:Interval>
              </Combinator>
            </Expression>
          </Nodes>
          <Edges>
            <Edge From="1" To="16" Label="Source1" />
            <Edge From="16" To="17" Label="Source1" />
            <Edge From="17" To="2" Label="Source1" />
            <Edge From="3" To="4" Label="Source1" />
            <Edge From="4" To="5" Label="Source1" />
            <Edge From="5" To="6" Label="Source1" />
            <Edge From="6" To="8" Label="Source1" />
            <Edge From="7" To="8" Label="Source2" />
